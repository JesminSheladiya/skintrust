---
import BaseLayout from "../layouts/BaseLayout.astro";
import BeforeAfterCard from "../components/BeforeAfterCard.jsx";
import VideoGallery from "../components/VideoGallery.jsx";
import clinicSchema from "../data/clinic-schema.js";
import faqSchema from "../data/faq-schema.json";
import { SITE_BASE } from "../data/site.js";

const base = import.meta.env.BASE_URL;

const waLink =
  "https://wa.me/919092232991?text=Hi%2C%20I%27d%20like%20to%20book%20a%20consultation%20at%20Skin%20Trust%20Hospital";

const header = {
  topbarAddress:
    "No. 28, Chairman Ramanujan Street, Karur — opp. Kamaatchi Amman Temple",
  topbarPhone: "+91 96269 23299",
  topbarPhoneHref: "tel:+919626923299",
  topbarHours: "Mon–Sat 9:30 AM–7:30 PM",
  navLinks: [
    { label: "TREATMENTS", href: "#treatments" },
    { label: "ABOUT", href: "#doctor" },
    { label: "BLOG", href: "#blog" },
    { label: "CONTACT", href: "#book" },
  ],
  ctaLabel: "BOOK APPOINTMENT",
  ctaHref: "#book",
};

const footer = {
  address: "No. 28, Chairman Ramanujan Street, Karur — 639001, Tamil Nadu.",
  phone: "+91 96269 23299",
  phoneHref: "tel:+919626923299",
  whatsapp: "WhatsApp: +91 90922 32991",
  whatsappHref: "https://wa.me/919092232991",
  columns: [
    {
      heading: "Hair & Skin",
      links: [
        { label: "PRP Hair Treatment", href: `${base}services/prp-hair-treatment-karur` },
        { label: "GFC Treatment", href: `${base}services/gfc-hair-treatment-karur` },
        { label: "FUE Hair Transplant", href: `${base}services/fue-hair-transplant-karur` },
        { label: "Acne Treatment", href: `${base}services/acne-treatment-karur` },
        { label: "Acne Scar Treatment", href: `${base}services/acne-scar-treatment-karur` },
      ],
    },
    {
      heading: "Laser & Anti-Ageing",
      links: [
        { label: "Laser Hair Removal", href: `${base}services/laser-hair-removal-karur` },
        { label: "Anti-Ageing & Botox", href: `${base}services/anti-ageing-treatment-karur` },
        { label: "HIFU Skin Tightening", href: `${base}services/skin-tightening-karur` },
        { label: "HydraFacial & Rejuvenation", href: `${base}services/skin-rejuvenation-karur` },
        { label: "Tattoo Removal", href: `${base}services/tattoo-removal-karur` },
      ],
    },
    {
      heading: "Clinic",
      links: [
        { label: "About Dr. Kavitha", href: `${base}about` },
        { label: "Patient Reviews", href: `${base}reviews` },
        { label: "Contact & Directions", href: `${base}contact` },
      ],
    },
  ],
};
---

<BaseLayout
  title="Skin Trust Hospital, Karur | Dr. Kavitha — Best Dermatologist & Skin Clinic in Karur"
  description="Skin Trust Hospital — Karur's most trusted dermatology clinic by Dr. Kavitha (MBBS, MD). Doctor-performed hair restoration, acne & scar correction, anti-ageing, laser hair removal, and skin surgery. 4.9★ from 3,600+ Google reviews. Book a consultation today."
  keywords="dermatologist in Karur, skin clinic Karur, hair treatment Karur, acne treatment Karur, laser hair removal Karur, PRP hair treatment Karur, best skin doctor Karur, Dr Kavitha Karur, skin trust hospital, hair transplant Karur, HIFU Karur, HydraFacial Karur, acne scar treatment Karur, Botox Karur, dermal fillers Karur"
  canonical={`${SITE_BASE}/`}
  ogTitle="Skin Trust Hospital, Karur | Dr. Kavitha — Best Dermatologist in Karur"
  ogDescription="Karur's highest-rated dermatology clinic. Doctor-performed hair, acne, laser, anti-ageing & skin surgery treatments by Dr. Kavitha. 4.9★ · 3,600+ Google reviews."
  ogUrl={`${SITE_BASE}/`}
  header={header}
  footer={footer}
  waFloatHref={waLink}
  waFloatLabel="Chat"
  mobileCallHref="tel:+919626923299"
  mobileCallLabel="Call clinic"
  mobileWhatsappHref={waLink}
  mobileWhatsappLabel="WhatsApp"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(clinicSchema)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- ======================= HERO ======================= -->
  <section class="hero">
    <div class="shell">
      <div>
        <p class="eyebrow">Karur's Most Trusted Dermatologist</p>
        <h1>
          Your skin deserves a diagnosis,<br /><em>not a guess.</em>
        </h1>
        <p class="lede">
          Founded in 2010 by Dr. Kavitha, Skin Trust Hospital has treated over 2
          lac patients and is across its 40+ offerings.
        </p>
        <div class="hero-cta">
          <a class="btn btn-solid" href="#book">Book a consultation</a>
          <a class="btn btn-ghost" href={waLink} target="_blank" rel="noopener">WhatsApp us</a>
        </div>
      </div>
      <figure class="hero-figure" style="margin: 0">
        <div class="arch">
          <img
            src={`${base}assets/images/home-cover.jpg`}
            alt="Skin Trust Hospital Karur"
            style="width: 100%; height: 100%; object-fit: cover; border-radius: 9999px 9999px 0 0;"
            loading="lazy"
          />
        </div>
        <div class="hero-badge">
          <div class="hb-stars" aria-hidden="true">★★★★★</div>
          <b>4.9</b>
          <span><em>3,600+</em> Google reviews</span>
        </div>
      </figure>
    </div>
  </section>

  <!-- ======================= CREDENTIAL STRIP ======================= -->
  <section class="strip">
    <div class="shell">
      <div><b>40+</b><span>Treatments offered</span></div>
      <div><b>16+</b><span>Years of Expertise</span></div>
      <div><b>200k+</b><span>Patients treated &amp; kits</span></div>
      <div><b>3600+</b><span>Google Reviews</span></div>
    </div>
  </section>

  <!-- ======================= TREATMENT CATEGORIES ======================= -->
  <section class="sec sec-warm" id="treatments">
    <div class="shell">
      <div class="sec-head" style="text-align: left; max-width: 100%;">
        <p class="eyebrow" style="text-align: left;">
          Our treatment categories
        </p>
        <div
          style="display: flex; gap: 40px; align-items: flex-start; justify-content: space-between; flex-wrap: wrap;"
        >
          <div style="flex: 1 1 400px;">
            <h2 style="margin: 0;">
              Six Service Categories,<br />Forty plus Services,<br />One trusted
              roof.
            </h2>
          </div>
          <div style="flex: 1 1 400px;">
            <p
              class="lede"
              style="text-align: left; margin: 0; padding-top: 8px;"
            >
              Redefining aesthetic excellence. Delivering bespoke
              transformations for skin, hair, and body, backed by the trust of
              thousands.
            </p>
          </div>
        </div>
      </div>

      <div class="cat-grid">
        <!-- 1. HAIR RESTORATION -->
        <article class="cat">
          <div class="cat-top">
            <span class="ph">Hair restoration<br />image 16:10</span>
          </div>
          <div class="cat-body">
            <h3>Hair Restoration</h3>
            <p>
              From diagnosing why your hair is falling to regrowing what you
              have lost — every protocol starts with trichoscopy and blood work,
              not a sales pitch.
            </p>
            <ul class="cat-list">
              <li>Trichoscopy (scalp diagnosis)</li>
              <li>PRP Hair Treatment (CDSCO-approved kit)</li>
              <li>GFC — Growth Factor Concentrate</li>
              <li>FUE Hair Transplant</li>
              <li>Exosome Therapy for Hair</li>
              <li>Low-Level Laser Therapy</li>
              <li>Mesotherapy</li>
              <li>Hair Botox</li>
            </ul>
            <a class="cat-cta" href={`${base}services/hair-restoration`}
              >Explore hair treatments →</a
            >
          </div>
        </article>

        <!-- 2. ACNE & SCAR CORRECTION -->
        <article class="cat">
          <div class="cat-top">
            <span class="ph">Acne &amp; scars<br />image 16:10</span>
          </div>
          <div class="cat-body">
            <h3>Acne &amp; Scar Correction</h3>
            <p>
              Teenage acne and adult hormonal acne are different problems. So
              are ice-pick scars and rolling scars. The treatment changes with
              the diagnosis — not the other way round.
            </p>
            <ul class="cat-list">
              <li>Medical acne management (grade-based)</li>
              <li>Chemical Peels · Pico &amp; Carbon Toning</li>
              <li>MNRF (microneedling radiofrequency)</li>
              <li>Fractional CO₂ &amp; Fractional Q-YAG</li>
              <li>Dermapen International</li>
              <li>Subcision</li>
              <li>Skin Boosters · PDRN · Exosomes</li>
              <li>LED Phototherapy</li>
            </ul>
<a class="cat-cta" href={`${base}services/acne-scar-treatment-karur`}
              >Explore acne & scar treatments →</a
            >
          </div>
        </article>

        <!-- 3. SKIN REJUVENATION -->
        <article class="cat">
          <div class="cat-top">
            <span class="ph">Skin rejuvenation<br />image 16:10</span>
          </div>
          <div class="cat-body">
            <h3>Skin Rejuvenation &amp; Glow</h3>
            <p>
              Maintenance treatments for radiance, texture and even tone —
              formulated for Indian skin that battles Tamil Nadu's sun, humidity
              and pigmentation year-round.
            </p>
            <ul class="cat-list">
              <li>HydraFacial</li>
              <li>Hydra Touch</li>
              <li>Laser Toning (Q-Switched Nd:YAG)</li>
              <li>Chemical Peels (brightening &amp; maintenance)</li>
              <li>Microdermabrasion · Microneedling</li>
              <li>IV Glutathione Therapy</li>
              <li>Skin Boosters, PDRN, Exosomes</li>
              <li>Dr. Platon</li>
            </ul>
            <a class="cat-cta" href={`${base}services/skin-rejuvenation-karur`}
              >Explore rejuvenation →</a
            >
          </div>
        </article>

        <!-- 4. ANTI-AGEING & LIFTING -->
        <article class="cat">
          <div class="cat-top">
            <span class="ph">Anti-ageing<br />image 16:10</span>
          </div>
          <div class="cat-body">
            <h3>Anti-Ageing &amp; Lifting</h3>
            <p>
              The goal is to look rested, not treated. Conservative dosing,
              natural movement, and energy-based lifting that tightens without
              surgery or downtime.
            </p>
            <ul class="cat-list">
              <li>Botox (wrinkle relaxation)</li>
              <li>Dermal Fillers (volume restoration)</li>
              <li>Thread Lifts (non-surgical face lift)</li>
              <li>HIFU (focused ultrasound lifting)</li>
              <li>Apollo Quattro</li>
              <li>MNRF Tightening</li>
              <li>PDRN Therapy</li>
              <li>Skin Boosters</li>
              <li>Under-Eye Rejuvenation (PDRN, peels, Dermapen)</li>
            </ul>
            <a class="cat-cta" href={`${base}services/anti-ageing-treatment-karur`}
              >Explore anti-ageing →</a
            >
          </div>
        </article>

        <!-- 5. LASER TREATMENTS -->
        <article class="cat">
          <div class="cat-top">
            <span class="ph">Laser treatments<br />image 16:10</span>
          </div>
          <div class="cat-body">
            <h3>Laser Treatments</h3>
            <p>
              Medical grade lasers operated by dermatologist - not technicians.
              Every setting calibrated for Indian skin types to minimise
              pigmentation risk.
            </p>
            <ul class="cat-list">
              <li>Laser Hair Removal (Diode — all body areas)</li>
              <li>Laser Toning for Pigmentation</li>
              <li>Carbon Laser Peel</li>
              <li>Tattoo Removal (Q-Switched Nd:YAG)</li>
              <li>Fractional CO₂ Resurfacing</li>
            </ul>
            <a class="cat-cta" href={`${base}services/laser-treatments-karur`}
              >Explore laser treatments →</a
            >
          </div>
        </article>

        <!-- 6. DERMATOLOGY & SKIN SURGERY -->
        <article class="cat">
          <div class="cat-top">
            <span class="ph">Dermatology &amp; surgery<br />image 16:10</span>
          </div>
          <div class="cat-body">
            <h3>Dermatology &amp; Skin Surgery</h3>
            <p>
              Clinical dermatology and minor surgery in a sterile hospital
              set-up — from mole removal to vitiligo grafting and phototherapy.
            </p>
            <ul class="cat-list">
              <li>Mole, Skin Tag &amp; Cyst Removal</li>
              <li>Ear Lobe Repair</li>
              <li>Vitiligo Surgery &amp; Skin Grafting</li>
              <li>Phototherapy (NB-UVB, PUVA, Excimer)</li>
              <li>Cryotherapy · Electrocautery</li>
              <li>Microblading · Dermoscopy</li>
            </ul>
<a class="cat-cta" href={`${base}services/dermato-surgery-karur`}
              >Explore dermatology & surgery →</a
            >
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ======================= WHY SKIN TRUST ======================= -->
  <section class="sec sec-dark">
    <div class="shell">
      <div class="sec-head">
        <p class="eyebrow">Why Karur trusts Dr. Kavitha</p>
        <h2>Advanced treatments deserve experienced hands.</h2>
        <p class="lede">
          At many clinics, a doctor recommends the treatment while someone else
          performs it. Here, your dermatologist is with you from consultation to
          procedure, ensuring consistency at every step.
        </p>
      </div>
      <div class="why-grid">
        <div class="why">
          <b>Your Procedure, Performed by <br />Dr. Kavitha</b>
          <p>
            Dr. Kavitha personally performs all advanced procedures, including
            laser treatments, injectable procedures, and surgical excisions,
            ensuring continuity of care from consultation through treatment and
            follow-up.
          </p>
        </div>
        <div class="why">
          <b>Diagnosis first, always</b>
          <p>
            Hair fall gets a trichoscopy and blood work before treatment is
            discussed. Pigmentation gets a proper cause mapped. You will never
            be sold six sessions of something you do not need.
          </p>
        </div>
        <div class="why">
          <b>CDSCO-approved consumables only</b>
          <p>
            GFC kits, Botox vials, fillers and PRP tubes are sourced through
            authorised channels. You can ask to see the product, the seal and
            the batch number before anything enters your skin.
          </p>
        </div>
        <div class="why">
          <b>Written pricing, no surprises</b>
          <p>
            Session cost, expected number of sittings and what happens if
            results are slower than expected — all discussed and documented
            before you pay a single rupee.
          </p>
        </div>
        <div class="why">
          <b>Calibrated for Indian skin</b>
          <p>
            Higher Fitzpatrick types pigment easily after aggressive laser
            settings. Protocols at Skin Trust are tuned for Tamil Nadu skin —
            not copied from Western manufacturer defaults.
          </p>
        </div>
        <div class="why">
          <b>Hospital-grade sterility</b>
          <p>
            Single-use needles and cannulas, autoclaved instruments, a dedicated
            procedure room, a separate minor OT and strict infection-control
            protocols — Because patient safety guides every detail of our
            clinical environment.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= DOCTOR ======================= -->
  <section class="sec" id="doctor">
    <div class="shell">
      <div class="doc">
        <figure class="arch" style="margin: 0">
          <img
            src={`${base}assets/images/dr-kavitha.jpg`}
            alt="Dr. Kavitha"
            style="width: 100%; height: 100%; object-fit: cover; border-radius: 9999px 9999px 0 0;"
            loading="lazy"
          />
        </figure>
        <div>
          <p class="eyebrow">Meet your dermatologist</p>
          <h2>Dr. Kavitha</h2>
          <p class="lede" style="margin-top: 18px">
            As Karur's first female dermatologist and the founder of Skin Trust
            Hospital, Dr. Kavitha K. B. has spent over two decades making
            specialised skin and hair care more accessible, ethical, and
            patient-focused.
          </p>

          <div class="doc-creds">
            <span class="cred">MBBS, MD and DDVL</span>
            <span class="cred">Aesthetic &amp; Laser Medicine</span>
            <span class="cred">Dermato-Surgery</span>
            <span class="cred">Hair Restoration Specialist</span>
          </div>
          <div class="doc-stats">
            <div><b>10,000+</b><span>Patients treated</span></div>
            <div><b>40+</b><span>Procedures offered</span></div>
            <div><b>3,600+</b><span>Google reviews</span></div>
          </div>
          <p class="sig">Dr. Kavitha</p>
          <div style="margin-top: 26px">
            <a class="btn btn-ghost" href={`${base}about`}>Read her full profile</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= TECHNOLOGY ======================= -->
  <section class="sec sec-dark">
    <div class="shell">
      <div class="sec-head">
        <p class="eyebrow">In the procedure room</p>
        <h2 style="white-space: nowrap; max-width: 100%;">
          The technology, fully disclosed
        </h2>
        <p class="lede">
          Every device we use is listed by name, not because it's impressive,
          but because you deserve to know exactly what's being used for your
          treatment.
        </p>
      </div>
      <div class="tech-grid">
        <div class="tech">
          <b>Fractional CO₂ Laser</b><span
            >Deep acne scars, skin resurfacing, mole and lesion removal.</span
          >
        </div>
        <div class="tech">
          <b>Pico &amp; Q-Switched Nd:YAG</b><span
            >Pigmentation, laser toning, tattoo removal, carbon peel.</span
          >
        </div>
        <div class="tech">
          <b>Diode Laser</b><span
            >Permanent hair reduction — face, underarms, legs, full body.</span
          >
        </div>
        <div class="tech">
          <b>MNRF</b><span
            >Microneedling radiofrequency for scars and skin tightening.</span
          >
        </div>
        <div class="tech">
          <b>HIFU</b><span
            >Focused ultrasound lifting for face, jawline and neck.</span
          >
        </div>
        <div class="tech">
          <b>Apollo Quattro</b><span
            >Multi-modality tightening and contouring platform.</span
          >
        </div>
        <div class="tech">
          <b>Dermapen International</b><span
            >Controlled-depth microneedling for scars and texture.</span
          >
        </div>
        <div class="tech">
          <b>Excimer &amp; NB-UVB</b><span
            >Targeted phototherapy for vitiligo and psoriasis.</span
          >
        </div>
        <div class="tech">
          <b>HydraFacial &amp; Hydra Touch</b><span
            >Deep cleansing, extraction and active infusion.</span
          >
        </div>
        <div class="tech">
          <b>Fraxis Duo</b><span
            >Combined CO₂ + micro-needle RF for advanced resurfacing.</span
          >
        </div>
        <div class="tech">
          <b>LED Phototherapy Panel</b><span
            >Anti-inflammatory light therapy for acne and healing.</span
          >
        </div>
        <div class="tech">
          <b>Trichoscope &amp; Dermoscope</b><span
            >High-magnification diagnostic imaging for hair and skin.</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= BEFORE & AFTER ======================= -->
  <section class="sec sec-warm" id="results">
    <div class="shell">
      <div class="sec-head centred">
        <p class="eyebrow centred">Patient results</p>
        <h2 style="white-space: nowrap; max-width: 100%;">
          Before and after. Drag to compare.
        </h2>
        <p class="lede">
          Photographs taken in the same room, same light, same distance. No
          filters, no retouching, no borrowed stock images — only real outcomes
          from real patients at Skin Trust Hospital.
        </p>
      </div>

      <div class="ba-grid">
        <BeforeAfterCard
          client:load
          afterNote="Month 6"
          beforeNote="Day 0"
          ariaLabel="Reveal before and after — hair"
          title="Hair density restored"
          body="Male, 29 — diffuse thinning at the crown. Six PRP sessions combined with medical management over six months."
          tags={["PRP", "6 sessions"]}
          mutedTags
        />
        <BeforeAfterCard
          client:load
          afterNote="Month 4"
          beforeNote="Day 0"
          ariaLabel="Reveal before and after — acne scars"
          title="Acne scars smoothened"
          body="Female, 24 — rolling and boxcar scars across both cheeks. MNRF combined with subcision over five sessions."
          tags={["MNRF + Subcision", "5 sessions"]}
          mutedTags
        />
        <BeforeAfterCard
          client:load
          afterNote="Month 3"
          beforeNote="Day 0"
          ariaLabel="Reveal before and after — pigmentation"
          title="Pigmentation cleared"
          body="Female, 36 — melasma across cheekbones. Chemical peels, laser toning and strict sun protection over eight sessions."
          tags={["Peels + Laser toning", "8 sessions"]}
          mutedTags
        />
      </div>

      <p class="disclaimer" style="color: var(--muted)">
        Photographs shared with written patient consent. Individual results vary
        with age, skin type, severity and adherence to the treatment plan — no
        outcome is guaranteed.
      </p>
    </div>
  </section>

  <!-- ======================= ASSURANCE SPLIT ======================= -->
  <section class="sec sec-warm" style="padding-top: 0;">
    <div class="shell">
      <div class="split">
        <div>
          <p class="eyebrow">The Skin Trust promise</p>
          <h2>
            Things we will<br />always do.
          </h2>
          <ul class="ticks">
            <li>
              Tell you honestly when a treatment is <b>not worth doing</b> for your
              case
            </li>
            <li>
              Give you the price and session count <b>before</b> the procedure, not
              after
            </li>
            <li>
              Show you the product, kit or vial being used — sealed and verified
            </li>
            <li>
              Set realistic timelines — most results take weeks to months, not
              days
            </li>
            <li>
              Keep your photographs, records and identity strictly confidential
            </li>
          </ul>
        </div>
        <div class="panel">
          <h3>Before you book</h3>
          <dl>
            <dt>Consultation</dt>
            <dd>
              By appointment; walk-ins accommodated when the schedule allows.
            </dd>
            <dt>Timings</dt>
            <dd>
              Monday to Saturday, 9:30 AM – 7:30 PM. Sunday by prior
              appointment.
            </dd>
            <dt>Languages</dt>
            <dd>Tamil and English.</dd>
            <dt>Payments</dt>
            <dd>Cash, UPI and cards accepted.</dd>
            <dt>Bring</dt>
            <dd>
              Any previous prescriptions, reports or products you are currently
              using.
            </dd>
            <dt>Fastest way</dt>
            <dd>
              WhatsApp — you will usually get a slot confirmed the same day.
            </dd>
          </dl>
          <div style="margin-top: 28px">
            <a class="btn btn-gold" href={waLink} target="_blank" rel="noopener">WhatsApp to book</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= REVIEWS ======================= -->
  <section class="sec sec-warm" id="reviews" style="padding-top: 0;">
    <div class="shell">
      <div class="review-wall" style="display: block; text-align: center;">
        <div
          class="review-copy"
          style="text-align: center; max-width: 100%; margin: 0 auto;"
        >
          <p class="big">
            Most Trusted Dermatology and<br />Skin Aesthetic Clinic in
            <strong>Karur, Tamilnadu</strong>
          </p>
          <p style="margin: 0 auto;">
            Patients drive in from Karur town, Kulithalai, Aravakurichi,
            Krishnarayapuram, Manmangalam — and increasingly from Trichy and
            Namakkal. Below is what a few of them wrote, unedited.
          </p>
        </div>
      </div>

      <div class="quotes">
        <article class="quote">
          <div class="stars" aria-hidden="true">★★★★★</div>
          <blockquote>
            She explained exactly why my hair was falling before suggesting a
            single treatment. Three other places just handed me a package
            without any diagnosis.
          </blockquote>
          <footer><b>R. Senthil</b>Hair treatment · Karur</footer>
        </article>
        <article class="quote">
