---
import { ICONS } from "../data/icons.js";

const { name = "sparkle", size = 28 } = Astro.props;
const inner = ICONS[name] || ICONS.sparkle;
---

<svg
  class="cat-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  width={size}
  height={size}
  aria-hidden="true"
  set:html={inner}
/>
