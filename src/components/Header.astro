---
interface NavLink {
  label: string;
  href: string;
  active?: boolean;
}

interface Props {
  topbarAddress: string;
  topbarPhone: string;
  topbarPhoneHref: string;
  topbarHours: string;
  navLinks: NavLink[];
  ctaLabel: string;
  ctaHref: string;
}

const {
  topbarAddress,
  topbarPhone,
  topbarPhoneHref,
  topbarHours,
  navLinks,
  ctaLabel,
  ctaHref,
} = Astro.props;
---

<div class="topbar">
  <div class="shell">
    <span>{topbarAddress}</span>
    <div class="t-right">
      <a href={topbarPhoneHref}>{topbarPhone}</a>
      <span>{topbarHours}</span>
    </div>
  </div>
</div>

<header class="nav">
  <div class="shell">
    <a class="brand" href="/">
      <img
        src="/assets/images/logo-color.png"
        alt="Skin Trust Hospital"
        style="max-height: 44px; width: auto; height: auto; object-fit: contain;"
      />
    </a>
    <nav class="nav-links" aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class:list={[link.active && "active"]}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-solid" href={ctaHref}>{ctaLabel}</a>
  </div>
</header>